{
  "name": "Account",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Unique username for login"
    },
    "password_hash": {
      "type": "string",
      "description": "SHA-256 hashed password"
    },
    "license_key": {
      "type": "string",
      "description": "The license key used to register"
    },
    "internal_license": {
      "type": "string",
      "description": "Internal license identifier"
    },
    "script_license": {
      "type": "string",
      "description": "Script license identifier"
    },
    "unique_identifier": {
      "type": "number",
      "description": "Sequential unique user ID"
    },
    "accent_color": {
      "type": "string",
      "default": "#ef4444"
    },
    "is_admin": {
      "type": "boolean",
      "default": false
    },
    "discord_id": {
      "type": "string",
      "description": "Linked Discord account ID"
    },
    "discord_username": {
      "type": "string",
      "description": "Linked Discord username"
    },
    "discord_avatar": {
      "type": "string",
      "description": "Linked Discord avatar hash"
    },
    "last_login": {
      "type": "string",
      "format": "date-time"
    },
    "selected_config_content": {
      "type": "string",
      "description": "The current cloud config to be executed"
    },
    "run_id": {
      "type": "string",
      "description": "A unique ID that changes every time Run is pressed"
    },
    "active_config_id": {
      "type": "string",
      "description": "The ID of the currently applied cloud config"
    },
    "executor_mode": {
      "type": "boolean",
      "default": false
    },
    "is_executor": {
      "type": "boolean",
      "default": false
    },
    "reveal_console": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "username",
    "password_hash"
  ]
}